{
  "name": "camera-apiserver",
  "private": true,
  "version": "0.1.0",
  "bin": "dist/api/server.js",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "codegen:proto": "protoc -I ../../contracts --ts_proto_out=src/grpc/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,useOptionals=messages ../../contracts/camera/camera_service.proto || echo 'protoc not installed; skipping'"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@grpc/grpc-js": "^1.10.6",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "jest": "^29.7.0",
    "pkg": "^5.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "pkg": {
    "assets": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "linux-arm64"
    ],
    "outputPath": "."
  }
}
